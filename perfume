<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AURA — Eau de Parfum</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-stone-900 text-stone-100 font-serif antialiased selection:bg-amber-700 selection:text-white">

  <!-- Navigation -->
  <nav class="flex items-center justify-between px-8 py-6 border-b border-stone-800">
    <div class="text-2xl font-light tracking-widest uppercase">Aura Parfums</div>
    <div class="flex items-center space-x-6 text-xs uppercase tracking-widest text-stone-400">
      <a href="#notes" class="hover:text-amber-200 transition">Notes</a>
      <a href="#collection" class="hover:text-amber-200 transition">Collection</a>
      <button class="border border-stone-600 px-4 py-2 hover:border-amber-200 hover:text-amber-200 transition">Bag (0)</button>
    </div>
  </nav>

  <!-- Hero Section -->
  <main class="max-w-6xl mx-auto px-6 py-16 grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
    <!-- Visual Display -->
    <div class="relative flex justify-center items-center p-8 bg-stone-800/40 rounded-2xl border border-stone-800">
      <div class="w-64 h-80 bg-gradient-to-t from-stone-800 to-stone-700 rounded-t-full rounded-b-xl border border-amber-900/30 flex items-center justify-center shadow-2xl relative">
        <div class="absolute top-4 w-12 h-10 bg-amber-600/80 rounded-sm"></div>
        <span class="text-xs uppercase tracking-[0.3em] text-amber-200/80 font-sans">N° 07 · Santal Noir</span>
      </div>
    </div>

    <!-- Product Info -->
    <div class="space-y-6">
      <p class="text-xs uppercase tracking-[0.25em] text-amber-500 font-sans">Artisan Reserve</p>
      <h1 class="text-4xl md:text-5xl font-light leading-tight">Santal Noir</h1>
      <p class="text-sm font-sans text-stone-400 leading-relaxed">
        An enigmatic blend of creamy sandalwood, smoky cedar, and subtle hints of spiced cardamom. Matured in French oak casks for depth and longevity.
      </p>

      <!-- Fragrance Notes Breakdown -->
      <div id="notes" class="grid grid-cols-3 gap-4 border-y border-stone-800 py-4 text-center font-sans">
        <div>
          <span class="block text-[10px] uppercase text-stone-500 tracking-wider">Top</span>
          <span class="text-xs text-stone-300">Cardamom, Bergamot</span>
        </div>
        <div>
          <span class="block text-[10px] uppercase text-stone-500 tracking-wider">Heart</span>
          <span class="text-xs text-stone-300">Iris, Violet Leaves</span>
        </div>
        <div>
          <span class="block text-[10px] uppercase text-stone-500 tracking-wider">Base</span>
          <span class="text-xs text-stone-300">Sandalwood, Amber</span>
        </div>
      </div>

      <!-- Purchasing Actions -->
      <div class="flex items-center space-x-6 pt-2">
        <span class="text-2xl font-sans font-light">$185 <span class="text-xs text-stone-500">/ 100ml</span></span>
        <button class="flex-1 bg-stone-100 text-stone-950 font-sans text-xs uppercase tracking-widest font-semibold py-4 hover:bg-amber-200 transition">
          Add to Cart
        </button>
      </div>
    </div>
  </main>

</body>
</html>
